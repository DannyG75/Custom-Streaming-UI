# Copy to .env and fill in. .env is gitignored.

# Where the external HDD is mounted on the NUC
MEDIA_ROOT=/mnt/media

# Immich
IMMICH_VERSION=release
UPLOAD_LOCATION=${MEDIA_ROOT}/photos
DB_PASSWORD=change-me-in-real-deploy
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
TYPESENSE_API_KEY=change-me-too

# Jellyfin
JELLYFIN_CONFIG_DIR=./jellyfin-config
JELLYFIN_CACHE_DIR=./jellyfin-cache
JELLYFIN_MEDIA_DIR=${MEDIA_ROOT}/videos

# Streaming UI server
PORT=3000
SITES_FILE=./data/sites.json
