# Copy to .env and fill in. .env is gitignored.

# NOTE: docker-compose's .env loader does NOT expand ${VAR} references inside
# other values — every line is a literal string. Use absolute paths here.

# Immich
IMMICH_VERSION=release
UPLOAD_LOCATION=/mnt/media/photos
DB_PASSWORD=change-me-in-real-deploy
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
TYPESENSE_API_KEY=change-me-too

# Jellyfin (config/cache live on the HDD too so a root-disk failure doesn't
# wipe your library settings)
JELLYFIN_CONFIG_DIR=/mnt/media/jellyfin-config
JELLYFIN_CACHE_DIR=/mnt/media/jellyfin-cache
JELLYFIN_MEDIA_DIR=/mnt/media/videos

# Streaming UI server
PORT=3000
SITES_FILE=./data/sites.json
